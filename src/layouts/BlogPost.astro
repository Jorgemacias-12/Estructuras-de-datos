---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import { Header } from '../components/Header';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { FloatingActions } from '@/components/FloatingActions';

type Props = CollectionEntry<'activities'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="app dark:bg-surface-200 min-h-screen dark:text-white">
		<Header client:only />

		<FloatingActions client:only />

		<main class="p-4">
			<article class="flex flex-col max-w-4xl gap-4 text-justify mx-auto">

				<section class="post-header-image">
					{
						heroImage && <img width="1020" height="510" src={heroImage} alt="" />
					}
				</section>
				
				<section class="post-title">
					<h1 class="text-center font-bold text-6xl max-md:text-xl max-sm:text-xl">{title}</h1>
				</section>

				<section class="post-date">
					<FormattedDate date={pubDate}/>
					{
						updatedDate && <p>Last updated on <FormattedDate date={updatedDate} /></p>
					}
				</section>

				<hr class="border-primary-100">

				<slot />
			</article>
		</main>
		<Footer />
	</body>

	<script>
    import { $theme } from '@/stores/theme'

    const darkBgClassNames = 'bg-raisin-black'
    const darkFgClassNames = 'text-white'
    const lightBgClassNames = 'bg-white'
    const lightFgClassNames = 'text-black'

    $theme.subscribe((value, oldValue) => {
      if (!oldValue) return

      const oldBg = oldValue === 'light' ? lightBgClassNames : darkBgClassNames;
      const oldFg = oldValue === 'light' ? lightFgClassNames : darkFgClassNames;
      const bg = value === 'light' ? lightBgClassNames : darkBgClassNames;
      const fg = $theme.get() === 'light' ? lightFgClassNames : darkFgClassNames;

      if (!bg) return
      if (!fg) return

      document.body.classList.remove(oldBg)
      document.body.classList.remove(oldFg)
      document.body.classList.add(bg)
      document.body.classList.add(fg)
    })

    const bg = $theme.get() === 'light' ? lightBgClassNames : darkBgClassNames;
    const fg = $theme.get() === 'light' ? lightFgClassNames : darkFgClassNames;

    document.body.classList.add(bg)
    document.body.classList.add(fg)
  </script>
</html>