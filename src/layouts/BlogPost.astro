---
import BaseHead from '@/components/BaseHead.astro'
import { FloatingActions } from '@/components/FloatingActions'
import FormattedDate from '@/components/FormattedDate.astro'
import { Header } from '@/components/Header'
import { getI18N } from '@/i18n'
import { appendbaseUrl } from '@/utils'
import type { CollectionEntry } from 'astro:content'

type Props = CollectionEntry<'activities'>['data']

const { title, description, pubDate, heroImage, updatedDate } = Astro.props
const { currentLocale } = Astro

const { PAGES } = getI18N(currentLocale!)
const { activities_slug } = PAGES
const { creationDateLabel, updatedDateLabel } = activities_slug
---

<html lang={currentLocale!}>
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="scroll-smooth">
    <Header client:only="react" lang={currentLocale!} />

    <FloatingActions client:only="react" />

    <main class="pt-[70px] px-2">
      <article
        class="article-content flex flex-col max-w-4xl gap-4 mx-auto px-2 md:mb-2"
      >
        <!-- TODO: include alt image here later -->
        <section class="post-header-image pt-2">
          {
            heroImage && (
              <img width="1024" height="510" src={appendbaseUrl(heroImage)} alt="article thumbnail photo" />
            )
          }
        </section>

        <section class="post-title">
          <h3 class="text-4xl text-center font-bold md:text-6xl">{title}</h3>
        </section>

        <section class="flex justify-evenly">
          <FormattedDate
            date={pubDate}
            lang={currentLocale!}
            text={creationDateLabel}
          />

          {
            updatedDate && (
              <FormattedDate
                date={updatedDate}
                lang={currentLocale!}
                text={updatedDateLabel}
              />
            )
          }
        </section>

        <hr />

        <slot />
      </article>
    </main>
  </body>
</html>

<script>
  import { $theme } from '@/stores/theme'

  const darkBgClassNames = 'bg-bunker-950'
  const darkFgClassNames = 'text-white'
  const lightBgClassNames = 'bg-white-smoke-500'
  const lightFgClassNames = 'text-black'

  const article = document.querySelector('.article-content')

  $theme.subscribe((value, oldValue) => {
    if (!oldValue) return

    const oldBg = oldValue === 'light' ? lightBgClassNames : darkBgClassNames
    const oldFg = oldValue === 'light' ? lightFgClassNames : darkFgClassNames
    const oldArticleBg = oldValue === 'light' ? 'bg-white' : 'bg-black_rain-800'
    const articleBg = value === 'light' ? 'bg-white' : 'bg-black_rain-800'
    const bg = value === 'light' ? lightBgClassNames : darkBgClassNames
    const fg = value === 'light' ? lightFgClassNames : darkFgClassNames

    if (!bg) return
    if (!fg) return
    if (!article) return

    document.body.classList.remove(oldBg)
    document.body.classList.remove(oldFg)
    article.classList.remove(oldArticleBg)

    document.body.classList.add(bg)
    document.body.classList.add(fg)
    article.classList.add(articleBg)
  })

  const bg = $theme.get() === 'light' ? lightBgClassNames : darkBgClassNames
  const fg = $theme.get() === 'light' ? lightFgClassNames : darkFgClassNames
  const articleBg = $theme.get() === 'light' ? 'bg-white' : 'bg-black_rain-800'

  document.body.classList.add(bg)
  document.body.classList.add(fg)
  if (article) article.classList.add(articleBg)
</script>
