---
import { Card } from '@/components/Card'
import { Header } from '@/components/Header'
import { LinkButton } from '@/components/LinkButton'
import { Section } from '@/components/Section'
import { getI18N } from '@/i18n'
import Layout from '@/layouts/Layout.astro'

import { appendbaseUrl } from '@/utils'

const { currentLocale } = Astro

const { PAGES } = getI18N(currentLocale!)
const { index } = PAGES
const { title, description } = index
---

<Layout title={title} description={description} keywords={''}>
  <Header client:only="react" lang={currentLocale!} />
  <main class="flex flex-col gap-10 mt-[70px] md:mt-0">
    <Section
      id="intro"
      className=""
      innerContainerClassName="flex flex-col gap-4"
    >
      <h2 class="font-bold text-2xl lg:text-4xl text-center">
        Activities Portfolio
      </h2>

      <p class="text-balance text-center text-sm">
        Explore the projects and work carried out by me during the Data Structures course.
      </p>

      <section class="flex p-2 gap-4 justify-center">
        <LinkButton
          client:only="react"
          id=""
          className="p-2 rounded-md text-sm"
          lightThemeClassNames="bg-raisin-black text-white"
          darkThemeClassnames="bg-persimmon"
          href={appendbaseUrl('/activities')}
        >
          Explore Activities
        </LinkButton>

        <LinkButton
          client:only="react"
          id=""
          className="p-2 rounded-md text-sm"
          lightThemeClassNames="border bg-white"
          darkThemeClassnames="bg-black_rain-900"
          href={appendbaseUrl('#studyPlan')}
        >
          View Study Plan
        </LinkButton>
      </section>
    </Section>

    <Section
      id="studyPlan"
      className=""
      innerContainerClassName="flex flex-col gap-4 max-w-4xl"
    >
      <h3 class="font-bold text-2xl lg:text-4xl text-center">
        Study Plan
      </h3>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 justify-center gap-2"
      >
        <Card
          client:only="react"
          iconClassName="fa-graduation-cap text-green-500"
          title="UA Type"
          description="Course"
        />
        <Card
          client:only="react"
          iconClassName="fa-book text-blue-500"
          title="Credit Value"
          description="11"
        />
        <Card
          client:only="react"
          iconClassName="fa-hourglass-start text-indigo-500"
          title="Weekly Hours"
          description="4"
        />
        <Card
          client:only="react"
          iconClassName="fa-hourglass-end text-red-500"
          title="Theory Hours/Semester"
          description="80"
        />
        <Card
          client:only="react"
          iconClassName="fa-graduation-cap text-yellow-500"
          title="Practice Hours/Semester"
          description="0"
        />
      </div>
    </Section>

    <Section
      id="studyPlan-develop"
      className="flex flex-col gap-10"
      innerContainerClassName="flex flex-col gap-4"
    >
      <h3 class="font-bold text-2xl lg:text-4xl text-center">
        Learning Objectives
      </h3>

      <p class="text-sm">
        Students will develop data structures and search and sorting algorithms to solve specific problems, evaluating the understanding of classical data structures.
      </p>

      <h3 class="font-bold text-2xl lg:text-4xl text-center">
        UA Competency
      </h3>

      <p class="text-sm">
        C.3 Intellectual capacity for recognizing the central role of algorithms and data structures. (AIS/ACM/IEEE C.3)
      </p>
    </Section>

    <Section
      id="studyPlan-finish"
      className=""
      innerContainerClassName="flex flex-col gap-4 "
    >
      <h3 class="font-bold text-2xl lg:text-4xl text-center">Contents</h3>

      <ol class="list-inside list-decimal flex flex-col gap-4">
        <li>
          Data containers: Structured data types, objects, and structural nesting
        </li>
        <li>ADT List, static implementation</li>
        <li>ADT Stack, static implementation</li>
        <li>ADT Queue, static implementation</li>
        <li>Searches: linear and binary search</li>
        <li>Sorting: Iterative and recursive</li>
        <li>Dynamic memory</li>
        <li>Pointers in data structures</li>
        <li>ADT List, dynamic implementation</li>
        <li>ADT Stack, dynamic implementation</li>
        <li>ADT Queue, dynamic implementation</li>
        <li>ADT Tree, dynamic implementation</li>
      </ol>

      <h4 class="font-bold text-xl lg:text-2xl text-center">
        Learning Products
      </h4>

      <p>
        Computational system for solving a real or fictitious problem that makes use of various data structures such as lists, stacks, queues, and binary trees using secondary storage.
      </p>
    </Section>
  </main>
</Layout>
