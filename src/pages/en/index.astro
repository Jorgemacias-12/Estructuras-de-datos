---
import CallToAction from '@/components/CallToAction.astro'

import { getI18N } from '@/i18n'
import { Header } from '@/components/Header'
import Footer from '@/components/Footer.astro'
import Layout from '@/layouts/Layout.astro'

const { currentLocale } = Astro

const lang = getI18N({ currentLocale })

const {
  SEO_TITLE,
  SEO_DESCRIPTION,
  SEO_KEYWORDS,
  WELCOME_MESSAGE,
  PAGE_CREATOR,
  PAGE_DESCRIPTION,
  PAGE_CALL_TO_ACTIONS,
  PAGE_CALL_TO_ACTION_TITLE,
} = lang
---

<!-- prettier-ignore -->
<Layout
  title={SEO_TITLE}
  description={SEO_DESCRIPTION}
  keywords={SEO_KEYWORDS}
>
  <Header client:only="react" />
  <main class="flex flex-col gap-16 relative landing-background p-2">
    <section class=" mx-auto p-2 max-w-screen-lg items-center flex flex-col gap-10 md:gap-20 md:flex-row">
      <section class="flex flex-col gap-10 md:gap-20">
        <h2 class="title">{WELCOME_MESSAGE}</h2>
        <h3 class="subtitle">{PAGE_CREATOR}</h3>
      </section>

      <img class="rounded-md aspect-square h-96 w-full" src="images/code.png" alt="code image" width="300" height="100">
    </section>

    <section class="mx-auto p-2 max-w-screen-lg items-center flex flex-col gap-10">
      <h3 class="title">{PAGE_CALL_TO_ACTION_TITLE}</h3>

      <section class="grid grid-cols-2 gap-2 max-lg:grid-cols-1 justify-center">
        {PAGE_CALL_TO_ACTIONS.map(({title, description, icon,
          url}) =>{
            return <CallToAction title={title} description={description} icon={icon} url={url} />
          })}
      </section>
    </section>

  </main>
  <Footer/>
</Layout>

<style></style>