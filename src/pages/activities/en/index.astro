---
import { Activity } from '@/components/Activity'
import { Header } from '@/components/Header'
import { Section } from '@/components/Section'
import { getI18N } from '@/i18n'
import Layout from '@/layouts/Layout.astro'
import { appendbaseUrl } from '@/utils'
import { getCollection } from 'astro:content'

const { currentLocale } = Astro

const { PAGES } = getI18N(currentLocale!)
const { activities } = PAGES
const { title, description, heading_content } = activities

const posts = (await getCollection('activities'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .filter((post) => post.data.lang === 'en')
---

<Layout title={title} description={description} keywords="">
  <Header client:only="react" lang={currentLocale!} />
  <main class="flex flex-col content p-4 max-w-4xl mx-auto gap-4 mt-[70px]">
    <h2 class="font-bold text-2xl lg:text-4xl text-center">
      {heading_content}
    </h2>

    <Section
      id="activities"
      className="lg:py-6"
      innerContainerClassName="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl lg:py-0"
    >
      {
        posts.map(({ slug, data }) => {
          const { title, description, pubDate, updatedDate, heroImage } = data
          const id = slug as string

          return (
            <Activity
              client:only="react"
              id={id}
              title={title}
              description={description}
              publicationDate={pubDate}
              updatedDate={updatedDate!}
              heroImage={appendbaseUrl(heroImage!)}
              lang={currentLocale!}
            />
          )
        })
      }
    </Section>
  </main>
</Layout>
