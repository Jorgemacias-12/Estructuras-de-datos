---
import { appendbaseUrl } from '@/utils'

type Props = {
  title: string
  image: string
  description: string
  alt?: string
}

const { title, description, image, alt } = Astro.props
---

<article class="card flex flex-col rounded-md">
  <img src={appendbaseUrl(image)} alt={alt!} class="p-2" />
  <section class="flex flex-col p-2 gap-2">
    <h3 class="font-bold ">{title}</h3>
    <p class="">{description}</p>
  </section>
</article>

<script>
  import { $theme } from '@/stores/theme'

  const light = ['bg-white', 'border']
  const dark = ['bg-black_rain-900', 'border-0']

  const cards = document.querySelectorAll('.card')

  cards.forEach((card) => {
    $theme.subscribe((value, oldValue) => {
      const oldClassNames = oldValue === 'light' ? light : dark
      const ClassNames = value === 'light' ? light : dark

      card.classList.remove(...oldClassNames)
      card.classList.add(...ClassNames)
    })
  })
</script>
