---
type Props = {
  title: string
  image: string
  description: string
}

const { title, description, image } = Astro.props
---

<article class="card flex flex-col gap-2 p-2 rounded-md h-fit">
  <section class="">
    <img src={image} class="w-full bg-white rounded-sm" alt="" />
  </section>
  <section class="flex flex-col gap-2 mt-2">
    <h3 class="font-bold">{title}</h3>
    <p class="text-left">{description}</p>
  </section>
</article>

<script>
  import { $theme } from '@/stores/theme'

  const light = ['bg-white-smoke-500', 'border']
  const dark = ['bg-raisin-black-600', 'border-0']

  const cards = document.querySelectorAll('.card')

  cards.forEach((card) => {
    $theme.subscribe((value, oldValue) => {
      const oldClassNames = oldValue === 'light' ? light : dark
      const ClassNames = value === 'light' ? light : dark

      card.classList.remove(...oldClassNames)
      card.classList.add(...ClassNames)
    })
  })
</script>
