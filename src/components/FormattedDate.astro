---
interface Props {
  date: Date
  lang: string
  text?: string
}

const { date, text, lang } = Astro.props

const i18nDate =
  lang === 'es'
    ? new Date().toLocaleDateString('es-mx')
    : new Date().toLocaleDateString('en-us')
---

<time class="" datetime={date.toISOString()}>
  {text!}{i18nDate}
</time>
