---

<ul
  class={`list p-2 transition-all duration-300 rounded-sm w-full max-w-screen-sm mx-auto`}
>
</ul>

<style></style>

<script>
  import { $theme } from '@/stores/theme'

  const contentListLightClassNames = ['bg-white-smoke-600', 'border']

  const contentListDarkClassNames = [
    'bg-raisin-black-600',
    'border',
    'border-raisin-black-700',
  ]

  const light = ['hover:bg-indigo-200', 'hover:text-indigo-800']
  const dark = ['hover:bg-yellow-200', 'hover:text-yellow-800']

  const listElement = document.querySelector('.list')
  const contentTags = document.querySelectorAll('.content')

  if (contentTags.length === 0 && listElement) {
    listElement.innerHTML =
      '<span class="bg-red-200 p-2 text-red-800 mx-auto w-full flex">No hay contenido para listar.</span>'
  }

  contentTags.forEach((el) => {
    if (el.getAttribute('data-section-title') === null) return

    let liEl = document.createElement('li')
    let contentLinkEl = document.createElement('a')

    // const contentLinkLight = [
    //   ""
    // ]

    // const contentLinkDark = []

    const contentLinkStylesClasses = [
      'block',
      'p-2',
      'font-bold',
      'w-full',
      'transition-all',
      'duration-300',
      'rounded-md',
    ]

    const theme = $theme.get() === 'light' ? light : dark

    contentLinkEl.classList.add('link');
    contentLinkEl.classList.add(...contentLinkStylesClasses)
    contentLinkEl.classList.add(...theme)

    contentLinkEl.href = `${document.URL.split('#')[0]}#${el.id}`
    contentLinkEl.text = el.getAttribute('data-section-title')!

    liEl.appendChild(contentLinkEl)

    listElement!.appendChild(liEl)
  })

  $theme.subscribe((value, oldValue) => {
    const oldClassNames =
      oldValue === 'light'
        ? contentListLightClassNames
        : contentListDarkClassNames
    const classNames =
      value === 'light' ? contentListLightClassNames : contentListDarkClassNames

    if (!listElement) return

    
    listElement.classList.remove(...oldClassNames)
    listElement.classList.add(...classNames)
    
    document.querySelectorAll('.link').forEach(tag => {
      if (!tag) return;
      
      const oldTheme = oldValue === 'light' ? light : dark;
      const theme = value === 'light' ? light : dark;

      tag.classList.remove(...oldTheme);
      tag.classList.add(...theme);
    })
  })

  if (listElement) {
    const bg =
      $theme.get() === 'light'
        ? contentListLightClassNames
        : contentListDarkClassNames

    listElement.classList.add(...bg)
  }
</script>