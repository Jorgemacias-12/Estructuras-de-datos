---
import { getI18N } from '@/i18n'
import SocialMedia from './SocialMedia.astro'
import { SOCIAL_MEDIA } from '@/locales'

const { currentLocale } = Astro

const lang = getI18N({ currentLocale })

const { FOOTER_TITLE, FOOTER_SOCIAL_MEDIA_SECTION_TITLE } = lang
---

<footer
  class="bg-raisin-black p-4 border-t border-b border-raisin-black-600 text-white flex flex-col md:flex-row justify-between items-center px-4 gap-4"
>
  <section>
    <p>
      {FOOTER_TITLE}
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="font-bold text-xl lg:text-center">{FOOTER_SOCIAL_MEDIA_SECTION_TITLE}</h2>
    
    <ul class="flex flex-col gap-5 lg:flex-row">
      {
        SOCIAL_MEDIA.map(({ name, icon, url }) => {
          return <SocialMedia openInOtherTab={true} name={name} icon={icon} url={url} />
        })
      }
    </ul>
  </section>

  <section>
    <p>&copy; {new Date().getFullYear()} Jorge Macias</p>
  </section>
</footer>